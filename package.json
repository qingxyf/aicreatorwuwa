{
  "name": "wuwa-toy-activity-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "dev:api": "tsx watch server/index.ts",
    "start:api": "tsx server/index.ts",
    "build:toy": "tsc -b && vite build --mode toy",
    "db:migrate": "tsx server/migrate.ts",
    "media:harden": "tsx server/harden-existing-media.ts",
    "check:architecture": "node scripts/harness/check-architecture.mjs",
    "check:bundle-size": "node scripts/harness/check-bundle-size.mjs",
    "check:precompletion": "npm run build && npm run lint && npm test && npm run check:architecture && npm run check:bundle-size",
    "deploy": "npm run build"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@hono/node-server": "^2.1.1",
    "ali-oss": "^6.23.0",
    "antd": "^5.24.8",
    "hono": "^4.7.7",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "@eslint/js": "^9.21.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.15.0",
    "jsdom": "^26.0.0",
    "tsx": "^4.23.12",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.7",
    "wrangler": "^4.0.0"
  }
}
