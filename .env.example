VITE_API_BASE_URL=https://api.example.com
VITE_TOY_BASE_PATH=/your-custom-toy-path/
# Production API must receive a platform-signed assertion verification endpoint.
IDENTITY_VERIFY_URL=https://identity-bridge.example/verify
IDENTITY_VERIFY_SECRET=set-on-the-server
# Only enable this weaker fallback when no signed identity bridge is available.
ALLOW_TOY_PROFILE_IDENTITY=false
MEDIA_PUBLIC_BASE_URL=https://api.example.com
# Production CORS only accepts this exact Toy public-page origin. Do not use a wildcard.
PUBLIC_APP_ORIGIN=https://www.bilibilitoy.com
MODE=production
VITE_TRUST_TOY_PROFILE=false
PORT=8787
POSTGRES_DB=wuwa
POSTGRES_USER=wuwa
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://wuwa:replace-with-a-long-random-password@db:5432/wuwa
DB_POOL_MAX=10
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=aixiaozhanandmingchaoxiaozhan
OSS_ACCESS_KEY_ID=server-only-ram-key
OSS_ACCESS_KEY_SECRET=server-only-ram-secret
# Prefer an attached ECS RAM role to static keys. Set one method, not both.
OSS_RAM_ROLE_NAME=
# Optional internal OSS endpoint; leave blank for the default public API endpoint.
OSS_ENDPOINT=
