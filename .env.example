VITE_API_BASE_URL=https://your-worker.example
VITE_TOY_BASE_PATH=/your-custom-toy-path/
# A production Worker must receive a platform-signed assertion verification endpoint.
IDENTITY_VERIFY_URL=https://identity-bridge.example/verify
IDENTITY_VERIFY_SECRET=set-with-wrangler-secret
MEDIA_PUBLIC_BASE_URL=https://your-worker.example
# Production CORS only accepts this exact Toy public-page origin. Do not use a wildcard.
PUBLIC_APP_ORIGIN=https://your-toy-public-page.example
